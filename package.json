{
  "name": "pi-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Production Pi runtime profile for Paperclip with web, zvec, and Paperclip MCP integrations.",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run check:scope && pnpm run check:launcher && pnpm run check:config",
    "check:launcher": "bash scripts/test-pi-arguments.sh",
    "check:config": "node scripts/check-config.mjs",
    "typecheck": "pnpm --filter pi-web-access typecheck && pnpm --filter pi-zvec-content typecheck",
    "check:scope": "node --test scripts/prepare-playpen-config.test.mjs"
  },
  "dependencies": {
    "@agnishc/edb-context-viewer": "0.21.1",
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@zvec/zvec-grep": "^0.2.1",
    "paperclip-mcp-server": "github:auralab-dev/paperclip-mcp#f2d1158b1f27ce5858be3520cfed36c5500cc2bc",
    "pi-mcp-adapter": "2.32.1",
    "pi-session-trace": "0.1.5",
    "@arhen/pi-core-skill-tool": "1.0.10",
    "typebox": "^1.1.38",
    "pi-playpen": "0.1.3",
    "jiti": "2.7.0"
  }
}
