# Provider credentials. Keep this file local and never commit .env.local.
TINYFISH_API_KEY=

# Pi model/provider credentials (set the variables required by your model).
OPENCODE_API_KEY=

# Paperclip agent runtime context. The Paperclip adapter normally injects these.
PAPERCLIP_API_URL=
PAPERCLIP_API_KEY=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_AGENT_ID=
PAPERCLIP_RUN_ID=

# Optional Paperclip request headers, encoded as one JSON object.
PAPERCLIP_MCP_HEADERS_JSON=

# Optional local overrides.
# PI_HARNESS_STATE_ROOT=./.pi/agents
# Optional explicit Paperclip instruction scope. Normally auto-detected from
# Paperclip's --append-system-prompt. Prefer ROOT when instructions reference
# sibling files; set only one of ROOT or FILE.
# PI_HARNESS_INSTRUCTIONS_ROOT=/absolute/path/to/current-agent/instructions
# PI_HARNESS_INSTRUCTIONS_FILE=/absolute/path/to/current-agent/AGENTS.md
# PI_DOCUMENT_CONVERT_PYTHON=
